# Test that the environment starts empty
< 
/usr/bin/printenv
$ SHELL
PROMPT PROMPT exit

# Test that we can set a simple enviornment variable
<
setenv FOOBAR foo
/usr/bin/printenv
$ SHELL
PROMPT PROMPT FOOBAR=foo
PROMPT exit

# Test that setenv can print a simple environment variable
<
setenv FOOBAR foo
setenv
$ SHELL
PROMPT PROMPT FOOBAR=foo
PROMPT exit

# Test that unsetenv works
<
setenv FOOBAR foo
/usr/bin/printenv
unsetenv FOOBAR
/usr/bin/printenv
$ SHELL
PROMPT PROMPT FOOBAR=foo
PROMPT PROMPT PROMPT exit

# Test that basic path searching works
<
setenv PATH /bin:/usr/bin
setenv
echo path search check
$ SHELL
PROMPT PROMPT PATH=/bin:/usr/bin
PROMPT path search check
PROMPT exit

# Test that a PATH containing a nonexistent directory is handled gracefully;
# the search skips the bad entry and finds the command in a later one
<
setenv PATH /does/not/exist:/bin
echo path skips missing dir
$ SHELL
PROMPT PROMPT path skips missing dir
PROMPT exit

# Test that setting PATH to empty (setenv PATH with no value) is handled
# gracefully: a bare command name is reported as not found instead of
# crashing, while the same command still runs when given by full path
<
setenv PATH
echo bare name should not be found
/bin/echo full path still works
$ SHELL
PROMPT PROMPT PROMPT full path still works
PROMPT exit
>2 /(Command not found)|(command not found)/
