# Test basic output redirection
<
/bin/rm -f redirectout.txt
/bin/echo out test > redirectout.txt
/bin/cat redirectout.txt
$ SHELL
>
PROMPT PROMPT PROMPT out test
PROMPT exit

# Test if output file is rewritten
<
/bin/rm -f redirectout.txt
/bin/echo rewrite one > redirectout.txt
/bin/echo rewrite two > redirectout.txt
/bin/cat redirectout.txt
$ SHELL
>
PROMPT PROMPT PROMPT PROMPT rewrite two
PROMPT exit

# Test output append
<
/bin/rm -f redirectout.txt
/bin/echo rewrite one >> redirectout.txt
/bin/echo rewrite two >> redirectout.txt
/bin/cat redirectout.txt
$ SHELL
>
PROMPT PROMPT PROMPT PROMPT rewrite one
rewrite two
PROMPT exit

# Test that >& captures a command's stderr. We use regexp to look for the
# error because of the changing error messages on different systems from
# touch. run-shelltest.sh creates the nowrite directory at mode 500; we don't
# use /etc, because it is writable for a root default user, where this test
# would both fail and create /etc/password on the student's system.
<
/bin/rm -f redirecterr
/usr/bin/touch nowrite/password >& redirecterr
/bin/cat redirecterr
$ SHELL
> /Permission denied/

# Test that >& captures stdout as well as stderr. pipesplit.sh writes one
# line to each stream, and both must land in the file; a shell that
# implements >& as stderr-only redirection fails here.
<
/bin/rm -f redirectboth.txt
./pipesplit.sh >& redirectboth.txt
/bin/cat redirectboth.txt
$ SHELL
>
PROMPT PROMPT PROMPT stdout-line
stderr-line
PROMPT exit

# Test redirect input
<
/bin/cat < redirectin.txt
$ SHELL
>
PROMPT Contents of the file redirectin
PROMPT exit

