# Test if output file isn't writeable. run-shelltest.sh creates the nowrite
# directory at mode 500; we don't use / or /etc, because those are writable
# for a root default user, where this test would both fail and leave a file
# behind on the student's system.
<
/bin/echo permission test > nowrite/redirectout.txt
$ SHELL
PROMPT PROMPT exit
>2 /nowrite\/redirectout.txt: Permission denied/

# Test redirect non-existenent input
<
/bin/rm -f does-not-exist.txt
/bin/cat < does-not-exist.txt
$ SHELL
PROMPT PROMPT PROMPT exit
>2
does-not-exist.txt: No such file or directory.

# Test redirect ambiguous output
<
/bin/ls > foo > bar
$ SHELL
PROMPT PROMPT exit
>2 /(Ambiguous output redirect|syntax error)/

# Test redirect ambiguous input
<
/bin/ls < foo < bar
$ SHELL
PROMPT PROMPT exit
>2 /(Ambiguous input redirect.|syntax error)/

