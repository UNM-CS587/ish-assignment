# Test what happens if we run a non-existent program. csh reports a failed
# exec as "Command not found.", whatever errno says, and README.md tells you
# to report errors the way csh does.
<
/bin/invalid
$ SHELL
PROMPT PROMPT exit
>2
/bin/invalid: Command not found.

# Test what happens if the file in the local directory isn't executable
<
/bin/chmod 000 ./testscript.sh; ./testscript.sh; /bin/chmod 700 ./testscript.sh
$ SHELL
PROMPT PROMPT exit
>2 /Permission denied/
